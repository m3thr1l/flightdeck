#!/bin/sh
# deck-tty CMD [ARGS...] — run an interactive program "combined".
#
# While the deck is on, fd 1 and fd 2 point at other panes' ptys. Interactive
# programs assume all their fds are ONE terminal: less, for example, reads
# keys from /dev/tty (the prompt pane) but switches raw mode on via fd 2 (the
# stderr pane) — so the prompt pane stays line-buffered and q/space/arrows
# just echo. Fix: give the program one terminal again. /dev/tty is always the
# controlling terminal = the prompt pane. Zoom that pane to fill the window
# for the duration, then put everything back.
#
# Same process tree, same shell, same env and cwd — nothing is respawned
# elsewhere. stdin is left alone, so `foo | less` still gets its pipe.

[ $# -gt 0 ] || { echo "usage: deck-tty CMD [ARGS...]" >&2; exit 2; }

# Deck off: be invisible.
[ -n "$DECK_ACTIVE" ] || exec "$@"

# The terminal to give the program: the shell's saved copies of its original
# stdout/stderr (fd numbers exported by deck), which are the prompt pane.
# Not a fresh open of /dev/tty: that is the same device, but ssh with its
# stdout on a newly opened /dev/tty gets its remote shell hung up within a
# second (macOS, observed). Fall back to /dev/tty when the fds did not
# survive the way here (some programs close inherited descriptors).
out=/dev/tty err=/dev/tty
[ -n "$DECK_SAVE_OUT" ] && ( : >&"$DECK_SAVE_OUT" ) 2>/dev/null && out=/dev/fd/$DECK_SAVE_OUT
[ -n "$DECK_SAVE_ERR" ] && ( : >&"$DECK_SAVE_ERR" ) 2>/dev/null && err=/dev/fd/$DECK_SAVE_ERR

# Remote deck (attached over ssh, no tmux on this side): one terminal, no zoom.
[ -n "$TMUX_PANE" ] || exec "$@" >"$out" 2>"$err"

zoomed() { [ "$(tmux display-message -p -t "$TMUX_PANE" '#{window_zoomed_flag}')" = 1 ]; }

unzoom=
if ! zoomed; then
    tmux resize-pane -Z -t "$TMUX_PANE" && unzoom=1
fi

"$@" >"$out" 2>"$err"
rc=$?

# Only undo a zoom we made, and only if the user hasn't already undone it.
[ -n "$unzoom" ] && zoomed && tmux resize-pane -Z -t "$TMUX_PANE"
exit $rc
